WORKBENCH_ENV=development
WORKBENCH_STORAGE_BACKEND=memory
WORKBENCH_DB_PASSWORD=replace-with-a-long-random-password
WORKBENCH_MINIO_USER=workbench
WORKBENCH_MINIO_PASSWORD=replace-with-another-long-random-password
WORKBENCH_POSTGRES_PORT=5432
WORKBENCH_REDIS_PORT=6379
WORKBENCH_MINIO_PORT=9000
WORKBENCH_MINIO_CONSOLE_PORT=9001
WORKBENCH_DATABASE_URL=postgresql+psycopg://workbench:${WORKBENCH_DB_PASSWORD}@localhost:${WORKBENCH_POSTGRES_PORT}/workbench
WORKBENCH_REDIS_URL=redis://localhost:6379/0
WORKBENCH_OBJECT_STORAGE_URL=http://localhost:9000
WORKBENCH_LOG_LEVEL=INFO
WORKBENCH_AUTH_SECRET=replace-with-a-long-random-signing-secret
WORKBENCH_BACKUP_ENCRYPTION_KEY=replace-with-a-different-long-backup-key
WORKBENCH_OUTBOX_MAX_ATTEMPTS=3

# 死信通知：配置 Webhook 后，死信登记时按事件去重发送一次脱敏通知；留空则不发送任何通知。
WORKBENCH_DEAD_LETTER_WEBHOOK_URL=
WORKBENCH_DEAD_LETTER_WEBHOOK_TIMEOUT_SECONDS=5
CONTENT_GENERATION_BACKEND=mock
CONTENT_MODEL_BASE_URL=
CONTENT_MODEL_NAME=
CONTENT_MODEL_API_KEY=
CONTENT_MODEL_TIMEOUT_SECONDS=30
CONTENT_MODEL_MAX_RETRIES=2
WORKBENCH_BOOTSTRAP_TOKEN=
WORKBENCH_SESSION_TTL_SECONDS=900

# 计划生成：工具白名单必须显式声明部署中已接通的工具；空表示不启用计划生成。
# 形状示例： WORKBENCH_PLANNER_TOOLS=[{"name":"knowledge.search","kind":"read"}]
WORKBENCH_PLANNER_BACKEND=mock
WORKBENCH_PLANNER_TOOLS=[]
WORKBENCH_PLANNER_MAX_STEPS=10
WORKBENCH_PLANNER_MODEL_BASE_URL=
WORKBENCH_PLANNER_MODEL_NAME=
WORKBENCH_PLANNER_MODEL_API_KEY=
WORKBENCH_PLANNER_MODEL_TIMEOUT_SECONDS=30
# 规划模型的数据分级资格：为 false 时，confidential 及以上风险任务的规划会被闸门拒绝（403）
WORKBENCH_PLANNER_MODEL_SENSITIVE_DATA=false

# 登录限流：5 分钟窗口内失败达阈值即锁定
WORKBENCH_LOGIN_MAX_FAILURES=5
WORKBENCH_LOGIN_WINDOW_SECONDS=300
WORKBENCH_LOGIN_LOCK_SECONDS=900

# 动态口令：管理员强制绑定，受限会话有效期上限
WORKBENCH_REQUIRE_ADMIN_TOTP=true
WORKBENCH_TOTP_ENROLLMENT_TTL_SECONDS=300

# 编排优化提案：默认运行时、比较样本门槛与改善阈值（未达门槛不生成提案）
WORKBENCH_ORCHESTRATION_DEFAULT_RUNTIME_KEY=mock
WORKBENCH_ORCHESTRATION_MIN_SAMPLES=5
WORKBENCH_ORCHESTRATION_IMPROVEMENT_THRESHOLD=0.1
