WORKBENCH_ENV=development
WORKBENCH_DB_PASSWORD=replace-with-a-long-random-password
WORKBENCH_MINIO_USER=workbench
WORKBENCH_MINIO_PASSWORD=replace-with-another-long-random-password
WORKBENCH_DATABASE_URL=postgresql+psycopg://workbench:${WORKBENCH_DB_PASSWORD}@localhost:5432/workbench
WORKBENCH_REDIS_URL=redis://localhost:6379/0
WORKBENCH_OBJECT_STORAGE_URL=http://localhost:9000
WORKBENCH_LOG_LEVEL=INFO
WORKBENCH_AUTH_SECRET=replace-with-a-long-random-signing-secret
