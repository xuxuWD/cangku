# 统一登录（SSO / OIDC）配置模板
#
# 用法
#   1. 复制为 `.env.sso`（或并入部署环境变量）；**真实值由部署密钥系统注入**。
#   2. 预检：`py scripts/sso_preflight.py`（会拉 IdP 的 discovery 与 JWKS 做一致性核对）
#   3. 无 IdP 时自检：`py scripts/sso_preflight.py --offline`（只校验配置，不发网络）
#
# 纪律（与 `.env.staging.example` 一致）
#   - 本文件只登记**元数据**（地址、标识、开关）；真实密钥一律由部署密钥系统注入。
#   - **禁止**把真实 client_secret 提交进仓库、聊天记录或工单正文。
#   - 预检脚本只输出「字段是否就绪」与「URL 主机」，**绝不打印 client_secret**。
#
# IdP 侧需提供或确认（联调前逐项确认，并写入交付记录）
#   [ ] issuer（必须与 discovery 文档里的 "issuer" 完全一致）
#   [ ] authorization / token / jwks 三个端点，或 discovery 地址
#   [ ] client_id 与 client_secret
#   [ ] 回调地址已登记，且与本文件的 WORKBENCH_SSO_REDIRECT_URI **完全一致**
#   [ ] 授权码模式（response_type=code）已启用，且支持 PKCE（S256）
#   [ ] 签名算法为 RS256（或 HS256）；本系统严格白名单，拒绝 alg=none
#   [ ] email 声明可用，且 email_verified=true（否则登录会被拒绝）
#   [ ] 是否强制 MFA（决定下面的 WORKBENCH_SSO_TRUST_IDP_MFA）
#   [ ] 用户邮箱必须与本工作台**已审批账号**的邮箱一致（本系统不自动建号）

# ── 总开关（fail-closed：false 时 SSO 全部接口返回 503，其它登录方式不受影响） ──
WORKBENCH_SSO_ENABLED=false

# ── 审计标签（仅用于审计明细 detail.provider，便于区分多个 IdP） ──────────────
WORKBENCH_SSO_PROVIDER=generic_oidc

# ── IdP 身份与端点（元数据，可登记） ────────────────────────────────────────
WORKBENCH_SSO_ISSUER=https://idp.example.com/realms/company
WORKBENCH_SSO_AUTHORIZATION_ENDPOINT=https://idp.example.com/realms/company/protocol/openid-connect/auth
WORKBENCH_SSO_TOKEN_ENDPOINT=https://idp.example.com/realms/company/protocol/openid-connect/token
WORKBENCH_SSO_JWKS_URI=https://idp.example.com/realms/company/protocol/openid-connect/certs

# ── 客户端标识与回调地址 ───────────────────────────────────────────────────
WORKBENCH_SSO_CLIENT_ID=workbench-companion
# 回调地址必须与 IdP 侧登记值完全一致（含协议、域名、路径、末尾斜杠）
WORKBENCH_SSO_REDIRECT_URI=https://workbench.example.com/api/v1/auth/sso/callback

# ── 请求的作用域 ──────────────────────────────────────────────────────────
# 必须包含 openid；email 用于按已验证邮箱匹配本系统账号（profile/name 可选）
WORKBENCH_SSO_SCOPES=openid email profile

# ── 策略开关 ─────────────────────────────────────────────────────────────
# 是否信任 IdP 已承担 MFA：
#   默认 false = **仍要求应用内 TOTP**（管理员账号），安全默认，无需改造回调流程；
#   仅当已书面确认 IdP 侧强制开启 MFA 时才可置 true，并在交付记录中留痕。
WORKBENCH_SSO_TRUST_IDP_MFA=false

# 授权 state 有效期（秒，60–900）：一次性 state/nonce 与 PKCE verifier 的存活上限
WORKBENCH_SSO_STATE_TTL_SECONDS=300

# 访问 IdP 端点的超时（秒，1–60）
WORKBENCH_SSO_TIMEOUT_SECONDS=10

# ── 【密钥】以下项必须由部署密钥系统注入，禁止在仓库/聊天/工单里出现真实值 ──────
# 客户端密钥（与 IdP 登记值一致；缺失即 fail-closed，SSO 不可用）
WORKBENCH_SSO_CLIENT_SECRET=<由部署密钥系统注入>
