# 隔离 staging 部署模板（独立主机 / 云资源）
# 复制为 .env.staging 后由部署密钥系统注入真实值，禁止提交任何真实值。
# 本文件只登记部署元数据：脚本不会读取或打印密钥值。
# 前置预检：python scripts/staging_preflight.py

# 环境与隔离标识
WORKBENCH_ENV=staging
WORKBENCH_STAGING_ID=customer-a-isolated
WORKBENCH_STAGING_TENANT_ID=tenant-staging-a
WORKBENCH_STORAGE_BACKEND=postgres

# 独立 PostgreSQL（独立主机或云实例，禁止 localhost）
WORKBENCH_DATABASE_URL=postgresql+psycopg://workbench:REPLACE_DB_PASSWORD@pg.staging.internal:5432/workbench

# 独立 Redis（独立实例或独立逻辑库，禁止 localhost）
WORKBENCH_REDIS_URL=redis://redis.staging.internal:6379/0

# 独立对象存储与独立命名空间（禁止 localhost）
WORKBENCH_OBJECT_STORAGE_URL=https://objects.staging.internal
WORKBENCH_OBJECT_NAMESPACE=staging-customer-a

# 部署注入的密钥：至少 32 位且两者不同，由部署密钥系统注入
WORKBENCH_AUTH_SECRET=REPLACE_WITH_32_PLUS_CHARS
WORKBENCH_BACKUP_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_32_PLUS_CHARS

# 交付元数据
WORKBENCH_OUTBOX_MAX_ATTEMPTS=3
WORKBENCH_RETENTION_POLICY={"tasks":180,"audit":730}
WORKBENCH_RUNTIME_VERSIONS={"mock":"0.1.0","ragflow":"v0.19.0","agentscope":"v1.2.3"}
WORKBENCH_APPLIED_MIGRATIONS=001_initial,002_event_outbox,003_dead_letters,004_knowledge_access_bindings,005_knowledge_access_audit,006_commercial_g0,007_commercial_retention,008_accounts,009_plan_proposals,010_audit_log,011_login_attempts,012_account_totp,013_run_records,014_orchestration_proposals,015_dead_letter_notifications,016_content_publications,017_sso_identity,018_session_revocations,019_inbox_items,020_run_finish_reason,021_runtime_states,022_workforce_directory,023_conversational_agent,024_governance_risk_levels,025_task_risk_level_critical,026_run_execution_authorization,027_dsh_tool_execution

# 外部 Runtime 元数据：地址、版本与能力白名单来自受控配置，认证头由部署环境注入
# 能力白名单为空会在应用启动期 fail-closed（RuntimeConfigError），示例值须与外部服务真实能力对齐。
# <KEY>_AUTH_TOKEN 必须由部署密钥系统注入，禁止在本模板中填写真实值。
# 下列端点/版本为示例值，须替换为受控配置中的真实值与固定版本号（拒绝 latest/main/head 一类浮动值）。
RAGFLOW_ENDPOINT=https://ragflow.staging.example
RAGFLOW_VERSION=v0.19.0
RAGFLOW_CAPABILITIES=knowledge_search
RAGFLOW_AUTH_INJECTED=true
AGENTSCOPE_ENDPOINT=https://agentscope.staging.example
AGENTSCOPE_VERSION=v1.2.3
AGENTSCOPE_CAPABILITIES=run,pause,resume,cancel,approvals,replay,usage
AGENTSCOPE_AUTH_INJECTED=true
# DeerFlow / Codex Worker / Hermes：本地独立进程（非外部云服务），地址允许 http；
# 认证可选——需要认证时同样由部署密钥系统注入 <KEY>_AUTH_TOKEN，禁止在本模板填写真实值。
DEERFLOW_ENDPOINT=http://127.0.0.1:9101
DEERFLOW_VERSION=pinned
DEERFLOW_CAPABILITIES=research,content_plan
CODEX_WORKER_ENDPOINT=http://127.0.0.1:9102
CODEX_WORKER_VERSION=pinned
CODEX_WORKER_CAPABILITIES=fde_file_read,sandbox_check
HERMES_ENDPOINT=http://127.0.0.1:9103
HERMES_VERSION=pinned
HERMES_CAPABILITIES=memory_proposal,skill_proposal
WORKBENCH_RUNTIME_NETWORK=ragflow.staging.example,agentscope.staging.example,127.0.0.1

# 隔离测试账号就绪标记：只登记就绪状态，不写入账号口令
RAGFLOW_TEST_ACCOUNT_READY=true
AGENTSCOPE_TEST_ACCOUNT_READY=true

# 内容工作台：staging 禁止内存仓储，真实模型需单独验收后再切换
# 切换真实模型时按 `.env.example` 的 CONTENT_MODEL_* / WORKBENCH_PLANNER_MODEL_* 配置；
# 地址带不带 /v1 均可，客户端统一请求 /v1/chat/completions。
WORKBENCH_CONTENT_STORE_BACKEND=sqlite
WORKBENCH_CONTENT_STORE_PATH=data/staging/content-workbench.sqlite3
WORKBENCH_CONTENT_GENERATION_BACKEND=mock

# 网页抓取：staging 只登记白名单域名；留空即关闭抓取（fail-closed）
WORKBENCH_CONTENT_SCRAPE_ALLOWED_DOMAINS=
WORKBENCH_CONTENT_SCRAPE_TIMEOUT_SECONDS=10
WORKBENCH_CONTENT_SCRAPE_MAX_BYTES=2000000
WORKBENCH_CONTENT_SCRAPE_MIN_INTERVAL_SECONDS=1
WORKBENCH_CONTENT_SCRAPE_USER_AGENT=CompanyWorkbenchBot/0.1

# 公众号发布：staging 默认关闭（留空三项即关闭）；真实发布需单独验收后再开启
WORKBENCH_CONTENT_PUBLISH_TARGET=wechat_mp
WORKBENCH_CONTENT_PUBLISH_ENDPOINT=
WORKBENCH_CONTENT_PUBLISH_ACCOUNT_ID=
WORKBENCH_CONTENT_PUBLISH_ACCESS_TOKEN=
WORKBENCH_CONTENT_PUBLISH_TIMEOUT_SECONDS=15

# 死信通知渠道：留空则不发送通知（死信仍可查可重放）
WORKBENCH_DEAD_LETTER_WEBHOOK_URL=
WORKBENCH_DEAD_LETTER_WEBHOOK_TIMEOUT_SECONDS=5

# 跨源部署：桌面端远程模式 / PWA 伴侣端与后端不同源时必须显式登记允许来源（裸来源，逗号分隔）。
# 留空即不放行任何跨源（fail-closed），且必须含 Authorization 头放行（已在代码内固定）。
# 禁止通配符 * 与带路径的地址；配置错误会在应用启动期直接报错。
WORKBENCH_CORS_ALLOWED_ORIGINS=
WORKBENCH_CORS_ALLOW_CREDENTIALS=false

# 统一登录（SSO / OIDC）：配置项与 IdP 侧交付清单见 `.env.sso.example`
# 未启用时留空即可；启用前先跑 `py scripts/sso_preflight.py`

# ---- 段二（dsh 接入段）执行与模型网关配置：共 25 项（规格 §4 的 24 项 + 网关侧 mint_secret） ----
# 口径见 docs/superpowers/specs/2026-09-12-dsh-integration-design.md §4；staging 默认全关（mock）。
# 启用真实执行 = WORKBENCH_AGENT_RUNTIME_BACKEND=dsh，且下列各项须全部就位。
# 密钥类（BODY_ENCRYPTION_KEY / MODEL_GATEWAY_UPSTREAM_API_KEY）必须由部署密钥系统注入，
# 禁止在本模板填写真实值；缺失时拒绝启用真实执行（不阻断整个进程启动）。
WORKBENCH_AGENT_RUNTIME_BACKEND=mock
# 执行镜像按 digest 钉死，禁止浮动 tag；示例留空，须替换为受控镜像 digest
WORKBENCH_EXEC_IMAGE_DIGEST=
# 执行工作卷根（per-run 唯一子目录，运行结束销毁；须与容器根不同设备）
WORKBENCH_EXEC_WORKSPACE_ROOT=
# 受信任且不可写的可执行根：可执行文件来源必须解析自这里
WORKBENCH_EXEC_TRUSTED_ROOTS=/usr/bin
# 单次执行硬上限（秒）：须覆盖 dsh initialize 冷启动（实测 53.2s / 78.9s）
WORKBENCH_EXEC_TIMEOUT_SECONDS=180
WORKBENCH_EXEC_PIDS_LIMIT=256
WORKBENCH_EXEC_MEMORY_MB=2048
WORKBENCH_EXEC_CPU_QUOTA=2.0
# 孤儿容器上限（§8 U17 ⑥）：超限 → 拒绝新执行并告警（fail-closed，不打挂进程）；
# 清扫在启动时 + 按 WORKBENCH_BODY_CLEANUP_INTERVAL_SECONDS 周期执行。
WORKBENCH_EXEC_ORPHAN_LIMIT=8
# dsh 精确版本（拒绝 latest/main/head 一类浮动值）；留空 = 未配置
WORKBENCH_DSH_VERSION=
# 关闭时 artifact.export 不装配（fail-closed）
WORKBENCH_ARTIFACT_EXPORT_ENABLED=false
# 正文密文密钥：32 字节原始密钥的 base64；由部署密钥系统注入，禁止在模板中填真实值
WORKBENCH_BODY_ENCRYPTION_KEY=
# 旧正文密文密钥（多值，**逗号分隔**的 base64，每个 = 32 字节原始密钥）：轮换期**仅用于解密**。
# **进程启动时读入** ⇒ 轮换 = 改配置 + 重启（**无热轮换**）；窗口结束后由运维从配置移除 + 重启。
# **缺失 / 留空 ⇒ 不使用旧密钥**（fail-closed）；由部署密钥系统注入，禁止在模板中填真实值。
WORKBENCH_BODY_ENCRYPTION_PREVIOUS_KEYS=
WORKBENCH_BODY_CLEANUP_INTERVAL_SECONDS=60
# 模型网关六项：供应商密钥只在网关侧；容器内只注入指向网关的地址与短期令牌。
# 硬约束：TOKEN_TTL_SECONDS 必须 ≥ EXEC_TIMEOUT_SECONDS。
WORKBENCH_MODEL_GATEWAY_BASE_URL=
WORKBENCH_MODEL_GATEWAY_TOKEN_TTL_SECONDS=300
# 上游供应商端点：只在网关侧/宿主侧出现，禁止进入容器
WORKBENCH_MODEL_GATEWAY_UPSTREAM_BASE_URL=
# 上游供应商密钥：由部署密钥系统注入，禁止在模板中填真实值
WORKBENCH_MODEL_GATEWAY_UPSTREAM_API_KEY=
WORKBENCH_MODEL_GATEWAY_UPSTREAM_TIMEOUT_SECONDS=60
WORKBENCH_MODEL_GATEWAY_MAX_RETRIES=0
# 网关控制面密钥（mint / revoke 鉴权）：由部署密钥系统注入，禁止在模板中填真实值；
# 缺失时网关拒绝启动（fail-closed）。注意：供应商密钥 = UPSTREAM_API_KEY，本项是控制面密钥。
WORKBENCH_MODEL_GATEWAY_MINT_SECRET=

# 执行回调边车四项（§3.5 P1 第 3 条 ②④ / §8 U20 方案 b-1 / §8 U21 裁决「候选②」）：
# 边车是**独立进程**，**只监听一个端口**、**双宿 workbench-exec-internal + 回调网**（门禁 §B14 判据 E）；
# **不得**加入工作台默认网络。②④ 判定在**工作台**（边车是无状态纯转发）。
# 唯一监听地址 / 端口：对外可达性由「只挂执行内网 + 回调网」限定，禁止再开第二个端口或第二条路由。
WORKBENCH_EXEC_CALLBACK_LISTEN_HOST=0.0.0.0
WORKBENCH_EXEC_CALLBACK_LISTEN_PORT=8081
# 边车 → 工作台的**受控出向**调用目标（工作台侧回调接收端点）；**留空即不启用边车**（fail-closed）。
# **禁止把回调地址烤进镜像**：只能由部署配置注入。
WORKBENCH_EXEC_CALLBACK_FORWARD_URL=
# 「边车 → 工作台」**预共享密钥**（对称鉴权；两侧同值）。**留空即拒绝**（两侧都 fail-closed）；
# **必须由部署密钥系统注入、不进仓库、不得烤进镜像**。
WORKBENCH_EXEC_CALLBACK_SHARED_SECRET=
