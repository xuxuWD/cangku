.env
.env.*
!.env.example
!.env.staging.example
!.env.sso.example
*.pem
*.key

# 外部依赖验收的原始证据（含脱敏后的请求/响应，不入库；仓库只提交结论）
.acceptance/

# 构建与编辑器文件
dist/
build/
node_modules/
*.tsbuildinfo
vite.config.js
vite.config.d.ts

